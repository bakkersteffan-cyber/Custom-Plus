.DS_Store
.env

# Werkmappen die niet bij de site horen: specs en sessienotities van de
# bouwagents (.claude/) en losse experimenten (dev/). test/ en docs/ blijven
# wel in de repo, maar netlify.toml serveert ze niet.
.claude/
dev/

# Door scripts/build-site.mjs gegenereerd; Netlify maakt dit bij elke deploy opnieuw
/assets/
/content/nl/
/index.html
/404.html
/diensten/
/ecommerce/
/relatiegeschenken/
/waarom-china/
/faq/
/over-ons/
/begrippen/
/hulpmiddelen/
/contact/
/blog/
/zoeken/
/privacy/
/images/css-bg-*
/robots.txt
/sitemap.xml
# Door scripts/build-chat-index.mjs gegenereerd
/chat/index.json

# Alleen voor scripts/ (Lighthouse, migratierunner, restore-drill); de site zelf heeft geen dependencies
node_modules/

# Volledige Lighthouse-rapporten (JSON) van scripts/lighthouse-check.mjs; lokale
# meetdata, hoort niet in de repo
scripts/.lighthouse-reports/

# Echte database-dumps (voorstel 50, scripts/supabase-backup.sh) horen nooit in git
backups/

# meetrapporten en schermafbeeldingen van scripts/mobile-audit.mjs
scripts/.mobile-audit/
